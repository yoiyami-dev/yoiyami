{
	"name": "yoiyami",
	"version": "1.0.0",
	"codename": "Dusk",
	"repository": {
		"type": "git",
		"url": "https://github.com/yoiyami-dev/yoiyami.git"
	},
	"private": true,
	"engines": {
		"node": ">=22.22.2 <23"
	},
	"scripts": {
		"build": "node ./scripts/build.js",
		"typecheck": "pnpm run typecheck:backend && pnpm run typecheck:test && pnpm run typecheck:client && pnpm run typecheck:sw",
		"typecheck:backend": "pnpm --dir packages/backend typecheck",
		"typecheck:test": "pnpm --dir packages/backend typecheck:test",
		"typecheck:client": "pnpm --dir packages/client typecheck",
		"typecheck:sw": "pnpm --dir packages/sw typecheck",
		"start": "pnpm --dir packages/backend exec node --experimental-json-modules ./built/index.js",
		"start:test": "pnpm --dir packages/backend exec cross-env NODE_ENV=test node --experimental-json-modules ./built/index.js",
		"init": "pnpm run migrate",
		"migrate": "pnpm --dir packages/backend exec typeorm migration:run -d ormconfig.js",
		"migrateandstart": "pnpm run migrate && pnpm run start",
		"gulp": "gulp build",
		"watch": "pnpm run dev",
		"dev": "node ./scripts/dev.js",
		"dev:services:up": "docker compose up -d --wait db redis",
		"dev:services:down": "docker compose stop db redis",
		"dev:services:logs": "docker compose logs -f db redis",
		"lint": "node ./scripts/lint.js",
		"audit:production": "pnpm audit --prod --audit-level high",
		"cy:open": "cypress open --browser --e2e --config-file=cypress.config.ts",
		"cy:run": "cypress run",
		"e2e": "start-server-and-test start:test http://localhost:61812 cy:run",
		"mocha": "pnpm --dir packages/backend exec cross-env NODE_ENV=test TS_NODE_FILES=true TS_NODE_TRANSPILE_ONLY=true TS_NODE_PROJECT=\"./test/tsconfig.json\" mocha",
		"test:prepare": "node ./scripts/test-prepare.js",
		"test:unit": "pnpm run test:prepare && pnpm --dir packages/backend test:unit",
		"test": "pnpm run mocha",
		"clean": "node ./scripts/clean.js",
		"clean-all": "node ./scripts/clean-all.js",
		"cleanall": "pnpm run clean-all"
	},
	"devDependencies": {
		"@types/gulp": "4.0.9",
		"@types/gulp-rename": "2.0.1",
		"@typescript-eslint/parser": "5.36.2",
		"cross-env": "7.0.3",
		"cssnano": "8.0.2",
		"cypress": "16.1.0",
		"execa": "5.1.1",
		"gulp": "4.0.2",
		"gulp-postcss": "10.0.0",
		"gulp-rename": "2.0.0",
		"gulp-replace": "1.1.3",
		"gulp-terser": "2.1.0",
		"js-yaml": "4.3.2",
		"start-server-and-test": "3.0.12",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@12.5.1"
}
